# ---------------------------------------------------------------------------
# Frontend environment template. Copy to `.env` to override defaults.
# ---------------------------------------------------------------------------

# Base URL the browser uses to reach the API (REST + SSE).
# Default is the relative path "/api", which the Vite dev server proxies to the
# backend (see vite.config.ts) and which works behind the U9 nginx reverse proxy.
# Set an absolute URL (e.g. http://localhost:3000/api) to bypass the proxy.
VITE_API_BASE_URL=/api
