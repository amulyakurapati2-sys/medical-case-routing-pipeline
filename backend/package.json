{
  "name": "medical-case-routing-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for the Event-Routed Request Pipeline (Medical Case Routing Pipeline)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && cp -R src/generated dist/generated",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p prisma/tsconfig.json && tsc -p test/tsconfig.json",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "openai": "^6.48.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
