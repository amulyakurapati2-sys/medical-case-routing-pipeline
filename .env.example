# ---------------------------------------------------------------------------
# Medical Case Routing Pipeline — environment template
# Copy to `.env` and fill in the REQUIRED values. Never commit your real `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# CORS: origin allowed to call the API (the frontend dev server by default)
CORS_ORIGIN=http://localhost:5173

# Max JSON request body size in bytes (default 1 MB)
BODY_LIMIT_BYTES=1048576

# --- Database (REQUIRED) -------------------------------------------------
# Local dev example matching docker-compose Postgres credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casepipeline?schema=public

# --- LLM provider (REQUIRED key) -----------------------------------------
# Default provider = Groq (free tier, OpenAI-compatible API).
# Paste YOUR OWN key below — this file must only ever contain a placeholder.
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Structured-output behavior + resiliency bounds
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Tier 2 confidence gate: classifications below this go to NEEDS_REVIEW (0.0–1.0)
CONFIDENCE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Drop-in provider blocks — uncomment ONE and comment the Groq block above.
# Any OpenAI-compatible endpoint works by swapping these three vars.
# ---------------------------------------------------------------------------

# --- OpenAI (tested) -----------------------------------------------------
# LLM_API_KEY=your-openai-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_JSON_MODE=true

# --- Google Gemini (OpenAI-compatible endpoint) --------------------------
# LLM_API_KEY=your-gemini-api-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-flash
# LLM_JSON_MODE=true
